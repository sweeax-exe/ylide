# Copy to .env (gitignored) and fill in. Never commit the token or paste it anywhere else.
# Bot token: Developer Portal > your application > Bot > Reset Token
DISCORD_TOKEN=
# Developer Portal > General Information > Application ID
DISCORD_APP_ID=
# Discord: Settings > Advanced > Developer Mode on, then right-click the server > Copy Server ID
DISCORD_GUILD_ID=
# Optional: where the ticket counter is kept (default: tools/discord/data)
# DATA_DIR=
